#--------------STAGE 1 STARTS------------
#--------------BUILD APPLICATION---------
# USING NODE.JS 20 IMAGE AS BASE IMAGE

FROM node:20-alpine 

# SET WORKING DIRECTORY INSIDE CONTAINTER

WORKDIR /app

# GET CODE
# COPY PACKAGE.JSON & PACKAGE-LOCK.JSON FIRST

COPY package*.json ./

# INSTALL DEPENDENCIES

RUN npm install

# COPY REMAINING APPLICATION SOURCE CODE
COPY . .

#VITE DEV SERVER RUNS ON PORT 5173 BY DEFAULT 

EXPOSE 5173

#START VITE DEV SERVER --HOST MAKES THE APPLICATION ACCESSIBLE FROM OUTSIDE CONATAINER

CMD ["npm", "run", "dev", "--", "--host"]

